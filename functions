function gl {
  if [[ $1 == "" ]]; then
    local LIMIT=20
  else
    local LIMIT=$1
  fi
  local HASH="%C(yellow)%h%C(reset)"
  local RELATIVE_TIME="%C(green)%ar%C(reset)"
  local AUTHORS="%C(bold blue)%an%C(reset)"
  local REFS="%C(red)%d%C(reset)"
  local SUBJECT="%s"
  local FORMAT="$HASH{$RELATIVE_TIME{$AUTHORS{$REFS $SUBJECT"
  git log --graph --color --pretty="tformat:$FORMAT" -$LIMIT | column -t -s '{' | less -FXRS
}

function kill-on-port {
  sudo lsof -iTCP -sTCP:LISTEN -n -P | grep ${1} | awk '{ print $2 }' | xargs kill -9;
}

function kill-all {
  ps aux | grep ${1} | tr -s ' ' | cut -d' ' -f2 | xargs kill -9;
}

function what-is-listening {
  sudo lsof -iTCP -sTCP:LISTEN -n -P | grep :${1}
}

function batch-rename {
  local PATTERN="s/$1/$2/g"
  for i in ./* ; do mv $i $(echo $i | sed -e $PATTERN) ; done;
}

function repro {
  mkdir -p $HOME/Projects/repros/$(echo $1 | sed 's/\//\-/g')
  cd $_
}

function clone {
  mkdir -p $HOME/Projects/$(echo $1 | cut -d '/' -f 1)
  cd $_
  git clone git@github.com:$1.git
  cd $(basename $1)
}

function cht {
  curl cheat.sh/$1
}

function gap {
  local BRANCH=$(git branch --show-current)
  if [[ "$BRANCH" = "master" || "$BRANCH" == "main" || "$BRANCH" == "develop" ]] then
    echo "Cannot force push to $BRANCH branch!"
  else
    git add -A && ga && git push origin $BRANCH -f --no-verify
  fi
}

function supabase-ssh-instance {
  aws ec2-instance-connect ssh \
    --instance-id "$2" \
    --region "$1" \
    --connection-type direct \
    --os-user ubuntu
}

function debug-wake-timeout {
  local region="$1"
  local instance="$2"
  local time_end="${3:-7d}"
  local profile="${4:-supa-prod-read-only}"
  local query_id query_status

  query_id=$(aws logs start-query \
    --profile "$profile" \
    --region "$region" \
    --log-group-name '/supabase/hibernation' \
    --start-time $(date -v-${time_end} +%s) \
    --end-time $(date +%s) \
    --query-string "fields @timestamp, MESSAGE | filter @logStream = \"${instance}/journald\" | filter MESSAGE like /(?i)(failed|fatal|error)/ | sort @timestamp asc" \
    --query 'queryId' --output text)

  while true; do
    query_status=$(aws logs get-query-results \
      --profile "$profile" \
      --region "$region" \
      --query-id "$query_id" \
      --query 'status' --output text)
    case "$query_status" in
      Complete) break ;;
      Failed|Cancelled) echo "Query $query_status" >&2; return 1 ;;
    esac
    sleep 1
  done

  aws logs get-query-results \
    --profile "$profile" \
    --region "$region" \
    --query-id "$query_id" \
    --output json | jq -r '.results[] | map(select(.field != "@ptr")) | map("\(.field)=\(.value)") | join("\t")'
}

